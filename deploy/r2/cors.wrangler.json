{
  "rules": [
    {
      "allowed": {
        "origins": ["http://localhost:5173", "http://localhost:4173", "http://localhost:5198"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "Content-Type", "ETag", "Accept-Ranges"],
      "maxAgeSeconds": 7200
    }
  ]
}
