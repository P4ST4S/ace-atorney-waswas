# Copy to r2.env (git-ignored) and fill in the R2 API token credentials. Read by `pnpm assets:upload` only:
# never by Vite, never by the browser bundle. Variables already set in the shell take precedence.
# Token: Cloudflare dashboard > R2 > Manage API tokens > "Object Read & Write", restricted to this bucket.
# (Setting the bucket CORS policy needs a different authorization: dashboard or `wrangler login`.)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 API endpoint of the account, without the bucket name (the bucket goes in R2_BUCKET).
R2_ENDPOINT=https://3ba4389dadfb525c4920fd6c0e13766f.r2.cloudflarestorage.com
R2_BUCKET=ace-atorney-waswas
# Optional consistency checks: the account of R2_ENDPOINT, and the S3 region (always "auto" on R2).
R2_ACCOUNT_ID=3ba4389dadfb525c4920fd6c0e13766f
R2_REGION=auto
# Optional: public URL used by the post-upload check when VITE_ASSET_BASE_URL (.env.remote) is not set.
R2_PUBLIC_BASE_URL=https://pub-fcafc9a980984336ba95440ef648c8cb.r2.dev
