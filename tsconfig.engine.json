{
  // Pure engine: no DOM, no Node, no framework. Enforces determinism at the type level.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": [],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.engine.tsbuildinfo"
  },
  "include": ["src/engine/**/*.ts"],
  "exclude": ["src/engine/**/*.test.ts"]
}
